{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:netcracker-dependencies",
    "github>Netcracker/renovate-config:annotated-versions",
    ":enablePreCommit",
    "github>Netcracker/renovate-config:automerge"
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "groupName": "dockerfile"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["conda"],
      "registryUrls": [
        "https://api.anaconda.org/package/conda-forge/",
        "https://prefix.dev/conda-forge/"
      ]
    },
    {
      "description": "conda-forge conda has no cp315 build; latest 26.9.3 is py314. Remove this cap when a py315 build exists.",
      "matchDatasources": ["conda"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
